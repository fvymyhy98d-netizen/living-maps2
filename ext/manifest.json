{
  "manifest_version": 3,
  "name": "活地图 · DeepSeek 桥",
  "version": "1.0",
  "description": "把「活地图」对话框里的问题带进 chat.deepseek.com，发出去后再把 DeepSeek 的回答自动送回网页里的对话框（不接 API、不存 Key）。",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://fvymyhy98d-netizen.github.io/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    {
      "matches": ["https://fvymyhy98d-netizen.github.io/living-maps2/*"],
      "js": ["bridge-page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["bridge-ds.js"],
      "run_at": "document_idle"
    }
  ]
}
